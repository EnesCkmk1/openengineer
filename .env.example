# Copy to .env and fill in only the values you use.
# Never commit .env. OpenEngineer reads the process environment and this file.

# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://openengineer:openengineer@127.0.0.1:5432/openengineer

# API bind. Keep the default on a shared machine. There is no authentication layer.
OPENENGINEER_HOST=127.0.0.1
OPENENGINEER_PORT=3001

# docker is the default and refuses to run commands when Docker is missing.
# process mode is NOT a security boundary. It runs allowlisted commands as the
# current user. Both variables must be set to enable it.
OPENENGINEER_SANDBOX=docker
OPENENGINEER_ALLOW_PROCESS_SANDBOX=false
OPENENGINEER_DOCKER_IMAGE=node:22-bookworm-slim

# Optional colon-separated list of directories that may be registered.
# When unset, any local git repository the OS user can read is accepted.
# OPENENGINEER_REPO_ROOTS=/home/me/src

# Model provider: openai, anthropic, or scripted.
# scripted is a deterministic test double. It is not an intelligent agent.
OPENENGINEER_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Required only when OPENENGINEER_MODEL_PROVIDER=scripted.
# OPENENGINEER_SCRIPTED_FILE=./evals/fixtures/session-bugfix.json

# Execution budgets.
OPENENGINEER_MAX_REPAIR_ATTEMPTS=3
OPENENGINEER_MAX_TOOL_CALLS=40
OPENENGINEER_MAX_MODEL_CALLS=60
OPENENGINEER_MAX_DURATION_MS=900000
OPENENGINEER_COMMAND_TIMEOUT_MS=120000
OPENENGINEER_MAX_INPUT_TOKENS=2000000
OPENENGINEER_MAX_OUTPUT_TOKENS=200000

# Directory for task worktrees. Defaults to ~/.openengineer/worktrees
# OPENENGINEER_WORKTREE_ROOT=
